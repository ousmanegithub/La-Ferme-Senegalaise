# Copy to .env and fill in real values. Never commit the real .env file
# (it's already in .gitignore / .dockerignore).

# --- Core Django ---------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=lafermesenegalaise.sn,www.lafermesenegalaise.sn
CSRF_TRUSTED_ORIGINS=https://lafermesenegalaise.sn,https://www.lafermesenegalaise.sn
BASE_URL=https://lafermesenegalaise.sn

# --- Database (used by fermesenegalaise/settings/production.py) ----------
# Format: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgres://fermesenegalaise:change-me@db:5432/fermesenegalaise
# Also read directly by docker-compose.yml for the db service:
POSTGRES_DB=fermesenegalaise
POSTGRES_USER=fermesenegalaise
POSTGRES_PASSWORD=change-me

# --- Outgoing e-mail (contact form notifications, Wagtail account e-mails) -
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@lafermesenegalaise.sn
CONTACT_FORM_RECIPIENT_EMAIL=contact@lafermesenegalaise.sn

# --- Optional: analytics / search console verification -------------------
GA4_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# --- Optional: error monitoring (leave empty to disable) ------------------
SENTRY_DSN=

# --- TLS/proxy -------------------------------------------------------------
# True when running behind a TLS-terminating proxy/load balancer (most
# hosting platforms and reverse-proxy setups) — the default is already True.
BEHIND_PROXY_SSL=True
SECURE_SSL_REDIRECT=True
